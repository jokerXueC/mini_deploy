# Optional overrides for scripts/bootstrap_server.sh.
# Copy to server.env for a non-interactive or preconfigured install.
# Paths must be absolute dedicated paths, use only A-Z/a-z/0-9/_/./@/+/- and
# must not overlap. User homes, temporary directories and critical system trees
# are rejected. Reuse the same file for upgrades; path migration is not automatic.
# server.env is sourced as root and may contain credentials; require root ownership
# and mode 0600 (or stricter).
# Unmarked legacy-looking APP_HOME, systemd and Nginx files are rejected by
# default. Enable this for one reviewed migration only, after taking an
# independent server snapshot; return it to false after a successful migration.
DEPLOY_ALLOW_LEGACY_INSTALL_ADOPTION=false
APP_HOME=/opt/mini_deploy
ENV_FILE=/etc/mini-deploy-agent.env
DATA_HOME=/var/lib/mini-deploy-agent
LOG_HOME=/var/log/mini_deploy
INSTALL_BACKUP_DIR=/var/backups/mini-deploy-agent
SERVICE_NAME=mini-deploy-agent
DEPLOY_DOMAIN=
# Default access is http://<server-public-ip>:6868; no domain is required.
# Optional display override when public IP detection is unavailable or NAT differs.
DEPLOY_PUBLIC_IP=
# auto asks in a TTY and safely skips missing Nginx without a TTY;
# yes preapproves installation; false disables Nginx setup.
SETUP_NGINX=auto
SETUP_HTTPS=ask
SETUP_DOCKER=ask
INSTALL_LANG=zh

# Required for non-interactive first install. Create this file with mode 0600,
# then remove it immediately after installation succeeds.
# DEPLOY_UI_PASSWORD_FILE=/root/.mini-deploy-password
