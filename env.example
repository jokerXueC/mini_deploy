# Informational compatibility values; the Agent always uses 0.0.0.0:6868.
DEPLOY_AGENT_HOST=0.0.0.0
DEPLOY_AGENT_PORT=6868
# Keep false unless using a trusted local proxy that overwrites X-Real-IP.
# Direct connections from non-loopback peers always ignore forwarded headers.
DEPLOY_TRUST_LOOPBACK_PROXY_HEADERS=false
MINI_DEPLOY_HOME=/opt/mini_deploy
DEPLOY_AGENT_ENV_FILE=/etc/mini-deploy-agent.env
DEPLOY_AGENT_SERVICE_NAME=mini-deploy-agent

# Legacy/default environment project secret, used only when projects.json is absent.
# It is never used as a fallback for entries in projects.json.
DEPLOY_WEBHOOK_SECRET=
# Query-string tokens can leak through proxy/access logs. Keep this disabled.
DEPLOY_ALLOW_QUERY_TOKEN=false

# UI login. Generate with:
# python3 /opt/mini_deploy/agent.py hash-password
DEPLOY_UI_PASSWORD_HASH=
DEPLOY_UI_SESSION_SECRET=
DEPLOY_UI_SESSION_TTL_SECONDS=28800
# Browser-based password initialization is intentionally unavailable. Use `agent.py set-password`.
# auto: set Secure cookie only when reverse proxy reports HTTPS.
# always/never can be used for unusual proxy setups.
DEPLOY_COOKIE_SECURE=auto

# Project config and logs.
# Leave empty to place projects.json beside DEPLOY_AGENT_STATE_FILE (the
# default is /var/lib/mini-deploy-agent/projects.json). The installer writes
# the canonical absolute path explicitly.
DEPLOY_PROJECTS_FILE=
DEPLOY_AGENT_LOG=/var/log/mini_deploy/mini-deploy-agent.log
DEPLOY_LOG_FILE=/var/log/mini_deploy/mini_deploy.log
DEPLOY_SERVICE_NAME=mini-deploy-app
DEPLOY_SERVICE_PORT=8000
DEPLOY_START_COMMAND=
DEPLOY_APP_DOMAIN=
DEPLOY_APP_HTTPS=false
DEPLOY_AGENT_STATE_FILE=/var/lib/mini-deploy-agent/state.json
DEPLOY_AUDIT_LOG_FILE=/var/lib/mini-deploy-agent/audit.jsonl
DEPLOY_PROJECT_CONFIG_BACKUP_DIR=/var/lib/mini-deploy-agent/backups

# Project config backup retention.
DEPLOY_PROJECT_CONFIG_BACKUP_LIMIT=20

# Optional system metrics tuning.
DEPLOY_SYSTEM_STATUS_CACHE_SECONDS=5
DEPLOY_NETWORK_MAX_MBPS=100

# Log display and download limits.
DEPLOY_LOG_TAIL_MAX_LINES=5000
DEPLOY_LOG_DOWNLOAD_MAX_BYTES=33554432
DEPLOY_DOCKER_LOG_TAIL_MAX_LINES=5000

# Optional Docker registry mirrors used by scripts/deploy.sample.sh.
# Keep disabled unless you explicitly want the deploy script to manage Docker's daemon.json.
DOCKER_REGISTRY_MIRRORS=disabled
DOCKER_DAEMON_CONFIG=/etc/docker/daemon.json
