# mini_deploy-managed: agent-systemd-v1
[Unit]
Description=mini_deploy lightweight deploy agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
RuntimeDirectory=mini-deploy-agent
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
WorkingDirectory=/opt/mini_deploy
EnvironmentFile=/etc/mini-deploy-agent.env
ExecStart=/usr/bin/python3 /opt/mini_deploy/agent.py
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
